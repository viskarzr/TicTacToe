<Window x:Name="winScPlace" x:Class="TicTacToe.winGameSecondPlace"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TicTacToe"
        mc:Ignorable="d"
        Title="TicTacToe" Height="800" Width="700" ResizeMode="NoResize" Icon="/icon.png" WindowStartupLocation="CenterScreen">
    <Window.Background>
        <ImageBrush ImageSource="/backgroundMain.jpg"/>
    </Window.Background>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <GroupBox Grid.Column="1" Header="Игровое поле" Grid.Row="1" Grid.ColumnSpan="5" Grid.RowSpan="6" Background="#FFF7CDE2" FontSize="16" FontWeight="SemiBold" BorderBrush="#FF8F7853">
            <Grid x:Name="gridGame" Margin="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Button x:Name="btn1" HorizontalContentAlignment="Center" Background="#FFF1DFEA" Click="Button_Click"/>
                <Button x:Name="btn2" HorizontalContentAlignment="Center" Grid.Column="1" Background="#FFF1DFEA" Click="Button_Click" />
                <Button x:Name="btn3" HorizontalContentAlignment="Center" Grid.Column="2" Background="#FFF1DFEA" Click="Button_Click"  />
                <Button x:Name="btn4" HorizontalContentAlignment="Center" Grid.Column="3" Background="#FFF1DFEA"  Click="Button_Click" />
                <Button x:Name="btn5" HorizontalContentAlignment="Center" Grid.Column="4" Background="#FFF1DFEA" Click="Button_Click" />
                <Button x:Name="btn6" HorizontalContentAlignment="Center" Grid.Column="5" Background="#FFF1DFEA" Click="Button_Click"  />

                <Button x:Name="btn7" HorizontalContentAlignment="Center" Grid.Row="1" Background="#FFF1DFEA"  Click="Button_Click" />
                <Button x:Name="btn8" HorizontalContentAlignment="Center" Grid.Row="1" Grid.Column="1" Background="#FFF1DFEA" Click="Button_Click" />
                <Button x:Name="btn9" HorizontalContentAlignment="Center" Grid.Row="1" Grid.Column="2" Background="#FFF1DFEA" Click="Button_Click" />
                <Button x:Name="btn10" HorizontalContentAlignment="Center" Grid.Row="1" Grid.Column="3" Background="#FFF1DFEA" Click="Button_Click" />
                <Button x:Name="btn11" HorizontalContentAlignment="Center" Grid.Row="1" Grid.Column="4" Background="#FFF1DFEA" Click="Button_Click" />
                <Button x:Name="btn12" HorizontalContentAlignment="Center" Grid.Row="1" Grid.Column="5" Background="#FFF1DFEA" Click="Button_Click" />

                <Button x:Name="btn13" HorizontalContentAlignment="Center" Grid.Row="2" Background="#FFF1DFEA" Click="Button_Click" />
                <Button x:Name="btn14" HorizontalContentAlignment="Center" Grid.Row="2" Grid.Column="1" Background="#FFF1DFEA" Click="Button_Click" />
                <Button x:Name="btn15" HorizontalContentAlignment="Center" Grid.Row="2" Grid.Column="2" Background="#FFF1DFEA" Click="Button_Click" />
                <Button x:Name="btn16" HorizontalContentAlignment="Center" Grid.Row="2" Grid.Column="3" Background="#FFF1DFEA" Click="Button_Click" />
                <Button x:Name="btn17" HorizontalContentAlignment="Center" Grid.Row="2" Grid.Column="4" Background="#FFF1DFEA" Click="Button_Click" />
                <Button x:Name="btn18" HorizontalContentAlignment="Center" Grid.Row="2" Grid.Column="5" Background="#FFF1DFEA" Click="Button_Click" />

                <Button x:Name="btn19" HorizontalContentAlignment="Center" Grid.Row="3" Background="#FFF1DFEA" Click="Button_Click" />
                <Button x:Name="btn20" HorizontalContentAlignment="Center" Grid.Row="3" Grid.Column="1" Background="#FFF1DFEA" Click="Button_Click" />
                <Button x:Name="btn21" HorizontalContentAlignment="Center" Grid.Row="3" Grid.Column="2" Background="#FFF1DFEA" Click="Button_Click" />
                <Button x:Name="btn22" HorizontalContentAlignment="Center" Grid.Row="3" Grid.Column="3" Background="#FFF1DFEA" Click="Button_Click" />
                <Button x:Name="btn23" HorizontalContentAlignment="Center" Grid.Row="3" Grid.Column="4" Background="#FFF1DFEA" Click="Button_Click" />
                <Button x:Name="btn24" HorizontalContentAlignment="Center" Grid.Row="3" Grid.Column="5" Background="#FFF1DFEA" Click="Button_Click" />

                <Button x:Name="btn25" HorizontalContentAlignment="Center" Grid.Row="4" Background="#FFF1DFEA" Click="Button_Click" />
                <Button x:Name="btn26" HorizontalContentAlignment="Center" Grid.Row="4" Grid.Column="1" Background="#FFF1DFEA" Click="Button_Click" />
                <Button x:Name="btn27" HorizontalContentAlignment="Center" Grid.Row="4" Grid.Column="2" Background="#FFF1DFEA" Click="Button_Click" />
                <Button x:Name="btn28" HorizontalContentAlignment="Center" Grid.Row="4" Grid.Column="3" Background="#FFF1DFEA" Click="Button_Click" />
                <Button x:Name="btn29" HorizontalContentAlignment="Center" Grid.Row="4" Grid.Column="4" Background="#FFF1DFEA" Click="Button_Click" />
                <Button x:Name="btn30" HorizontalContentAlignment="Center" Grid.Row="4" Grid.Column="5" Background="#FFF1DFEA" Click="Button_Click" />


                <Button x:Name="btn31" HorizontalContentAlignment="Center" Grid.Row="5" Background="#FFF1DFEA" Click="Button_Click" />
                <Button x:Name="btn32" HorizontalContentAlignment="Center" Grid.Row="5" Grid.Column="1" Background="#FFF1DFEA" Click="Button_Click" />
                <Button x:Name="btn33" HorizontalContentAlignment="Center" Grid.Row="5" Grid.Column="2" Background="#FFF1DFEA" Click="Button_Click" />
                <Button x:Name="btn34" HorizontalContentAlignment="Center" Grid.Row="5" Grid.Column="3" Background="#FFF1DFEA" Click="Button_Click" />
                <Button x:Name="btn35" HorizontalContentAlignment="Center" Grid.Row="5" Grid.Column="4" Background="#FFF1DFEA" Click="Button_Click" />
                <Button x:Name="btn36" HorizontalContentAlignment="Center" Grid.Row="5" Grid.Column="5" Background="#FFF1DFEA" Click="Button_Click" />
            </Grid>
        </GroupBox>
        <TextBlock x:Name="tbGameScore" Grid.Column="2" Grid.ColumnSpan="3" HorizontalAlignment="Center" Margin="5" Grid.Row="7" TextWrapping="Wrap" Text="ИГРОВОЙ СЧЕТ" VerticalAlignment="Top" FontWeight="DemiBold" FontSize="16" Foreground="#FF270E03"/>
        <Button x:Name="btnMainMenu" Content="НА ГЛАВНУЮ" FontWeight="DemiBold" Click="btnMainMenu_Click"/>
        <Button x:Name="btnRules" Grid.Column="6" Content="ПРАВИЛА" FontSize="14" Click="btnRules_Click"/>
        <TextBlock x:Name="tbPlayerMove" Grid.Column="2" HorizontalAlignment="Center" TextWrapping="Wrap" Text="ХОД ИГРОКА" VerticalAlignment="Center" Grid.ColumnSpan="3" FontSize="28" FontWeight="DemiBold"/>
    </Grid>
</Window>
