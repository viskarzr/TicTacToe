<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="backgroundMain.jpg" />
    <None Remove="icon.png" />
    <None Remove="iconTicTacToe.jpg" />
    <None Remove="MenuGame.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Extended.Wpf.Toolkit" Version="5.1.2" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="backgroundMain.jpg" />
    <Resource Include="icon.png" />
    <Resource Include="iconTicTacToe.jpg" />
    <Resource Include="MenuGame.png" />
  </ItemGroup>

</Project>
