<Window x:Name="MainGameWin" x:Class="TicTacToe.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TicTacToe"
        mc:Ignorable="d"
        Title="TicTacToe" Height="750" Width="600" ResizeMode="NoResize" Icon="/iconTicTacToe.jpg">
    <Window.Background>
        <ImageBrush ImageSource="/backgroundMain.jpg"/>
    </Window.Background>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <GroupBox Grid.Column="1" Header="Игровое поле" Grid.Row="1" Grid.ColumnSpan="5" Grid.RowSpan="6" Background="#FFF7CDE2" FontSize="16" FontWeight="SemiBold" BorderBrush="#FF8F7853">
            <Grid x:Name="gridGame" Margin="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Button x:Name="btn1" HorizontalContentAlignment="Center" Background="#FFF1DFEA"/>
                <Button x:Name="btn2" HorizontalContentAlignment="Center" Grid.Column="1" Background="#FFF1DFEA"/>
                <Button x:Name="btn3" HorizontalContentAlignment="Center" Grid.Column="2" Background="#FFF1DFEA"/>
                <Button x:Name="btn4" HorizontalContentAlignment="Center" Grid.Row="1" Background="#FFF1DFEA"/>
                <Button x:Name="btn5" HorizontalContentAlignment="Center" Grid.Column="1" Grid.Row="1" Background="#FFF1DFEA"/>
                <Button x:Name="btn6" HorizontalContentAlignment="Center" Grid.Row="1" Grid.Column="2" Background="#FFF1DFEA"/>
                <Button x:Name="btn7" HorizontalContentAlignment="Center" Grid.Row="2" Background="#FFF1DFEA"/>
                <Button x:Name="btn8" HorizontalContentAlignment="Center" Grid.Row="2" Grid.Column="1" Background="#FFF1DFEA"/>
                <Button x:Name="btn9" HorizontalContentAlignment="Center" Grid.Row="2" Grid.Column="2" Background="#FFF1DFEA"/>
            </Grid>
        </GroupBox>
        <TextBlock x:Name="tbGameScore" Grid.Column="2" Grid.ColumnSpan="3" HorizontalAlignment="Center" Margin="5" Grid.Row="7" TextWrapping="Wrap" Text="ИГРОВОЙ СЧЕТ" VerticalAlignment="Top" FontWeight="DemiBold" FontSize="16" Foreground="#FF270E03"/>
        <Button x:Name="btnMainMenu" Content="НА ГЛАВНУЮ" FontWeight="DemiBold"/>
        <Button Grid.Column="6" Content="Настройки" FontSize="14"/>
        <TextBlock x:Name="tbPlayerMove" Grid.Column="2" HorizontalAlignment="Center" TextWrapping="Wrap" Text="ХОД ИГРОКА" VerticalAlignment="Center" Grid.ColumnSpan="3" FontSize="28" FontWeight="DemiBold"/>
    </Grid>
</Window>
