<Window x:Name="winMenu" x:Class="TicTacToe.WinMainMenu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TicTacToe"
        mc:Ignorable="d"
        Title="TicTacToe" Height="750" Width="600" ResizeMode="NoResize" Icon="/icon.png" WindowStartupLocation="CenterScreen">
    <Window.Background>
        <ImageBrush ImageSource="/MenuGame.png"/>
    </Window.Background>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Column="0" Grid.ColumnSpan="6" HorizontalAlignment="Center"  TextWrapping="Wrap" Text="КРЕСТИКИ-НОЛИКИ" VerticalAlignment="Center" FontSize="72" FontWeight="DemiBold" FontFamily="XO Thames" Foreground="#FFAA1763" TextAlignment="Center" Grid.RowSpan="2"/>
        <StackPanel Grid.Column="1" Grid.Row="2" Grid.ColumnSpan="4" Grid.RowSpan="3">
            <Button x:Name="btnGameSimple" Content="НАЧАТЬ ИГРУ (3Х3)" Height="72" FontSize="20" FontFamily="XO Thames" FontWeight="Bold" Click="btnGameSimple_Click"/>
            <Button x:Name="btnGameBFild" Content="НАЧАТЬ ИГРУ (6Х6)" Height="72" FontSize="20" FontFamily="XO Thames" FontWeight="Bold"/>
            <Button Content="НАЧАТЬ ИГРУ (БОТ ДЛЯ 3Х3)" Height="72" FontSize="20" FontFamily="XO Thames" FontWeight="Bold"/>
            <Button x:Name="btnInfo" Content="О ПРОГРАММЕ" Height="72" FontSize="20" FontFamily="XO Thames" FontWeight="Bold"/>
            <Button x:Name="btnExit" Content="ВЫЙТИ ИЗ ИГРЫ" Height="72" FontSize="20" FontFamily="XO Thames" FontWeight="Bold" Click="btnExit_Click"/>
        </StackPanel>
    </Grid>
</Window>
